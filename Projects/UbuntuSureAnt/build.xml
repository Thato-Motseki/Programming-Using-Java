<?xml version="1.0" encoding="UTF-8"?>
<project name="UbuntuSureAnt" default="run" basedir=".">
    <description>UbuntuSure Insurance Management System - NetBeans Ant project</description>
    <property name="src.dir" value="src"/><property name="build.dir" value="build/classes"/><property name="main.class" value="ubuntusure.app.Main"/>
    <path id="project.classpath"><fileset dir="lib"><include name="*.jar"/></fileset></path>
    <target name="clean"><delete dir="build"/></target>
    <target name="compile"><mkdir dir="${build.dir}"/><javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false" source="17" target="17" encoding="UTF-8"><classpath refid="project.classpath"/></javac><copy todir="${build.dir}"><fileset dir="src" excludes="**/*.java"/></copy></target>
    <target name="run" depends="compile"><java classname="${main.class}" fork="true" failonerror="true"><classpath><pathelement location="${build.dir}"/><path refid="project.classpath"/></classpath></java></target>
</project>
